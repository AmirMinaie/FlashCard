<HomeScreen>:
    name: "HomeScreen"

    BoxLayout:
        orientation: "vertical"

        MDBottomNavigation:
            id: bottom_nav
            name: "switch_tab"
            on_switch_tabs: root.on_tab_switch(*args)

            ##################################################
            # Dashboard
            ##################################################

            MDBottomNavigationItemA:
                name: "dashboard_tab"
                icon: "view-dashboard-outline"
                text: "Dashboard"

                DashboardScreen:


            ##################################################
            # Today's Study
            ##################################################

            MDBottomNavigationItemA:
                name: "today_study_tab"
                icon: "book-open-page-variant-outline"
                text: "Today's Study"

                TodayStudyScreen:


            ##################################################
            # Review
            ##################################################

            MDBottomNavigationItemA:
                name: "review_tab"
                icon: "play-circle-outline"
                text: "Review Today"

                ReviewScreen:


            ##################################################
            # Add Cards
            ##################################################

            MDBottomNavigationItemA:
                name: "add_tab"
                icon: "plus-circle-outline"
                text: "Add Cards"

                AddFlashCardScreen:


            ##################################################
            # List Cards
            ##################################################

            MDBottomNavigationItemA:
                name: "list_tab"
                icon: "cards-outline"
                text: "List Cards"

                FlashCardListScreen: